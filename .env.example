# ==============================================================================
# Polygon 主网 (ChainId = 137) 部署与验证配置示例
# ==============================================================================

# 部署者钱包私钥（用于广播交易，需确保账户内有足额 POL/MATIC 作为 Gas 费）
PRIVATE_KEY=your_private_key_here

# Polygon 主网 RPC 节点 URL（推荐 dRPC 提供的稳定免费公共节点）
POLYGON_RPC=https://polygon.drpc.org

# Etherscan 统一 API Key（已整合至 Etherscan V2，用于多链合约开源验证）
ETHERSCAN_API_KEY=your_etherscan_api_key_here
